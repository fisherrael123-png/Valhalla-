{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "conversation_entity_registry",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "kb",
    "registry_type",
    "updated_at",
    "id_policy",
    "entities"
  ],
  "properties": {
    "version": {
      "type": "integer",
      "const": 1
    },
    "kb": {
      "type": "string",
      "minLength": 1
    },
    "registry_type": {
      "type": "string",
      "const": "conversation_entity_registry"
    },
    "updated_at": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "id_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "prefix",
        "format",
        "next_id"
      ],
      "properties": {
        "prefix": {
          "type": "string",
          "const": "conv_ent"
        },
        "format": {
          "type": "string",
          "const": "conv_ent_000001"
        },
        "next_id": {
          "type": "string",
          "pattern": "^conv_ent_\\d{6}$"
        }
      }
    },
    "description": {
      "type": "string"
    },
    "entities": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "canonical_label",
          "type",
          "aliases",
          "status",
          "created_at",
          "updated_at",
          "content_file",
          "scope",
          "summary",
          "resource_conversations"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^conv_ent_\\d{6}$"
          },
          "canonical_label": {
            "type": "string",
            "minLength": 1
          },
          "type": {
            "type": "string",
            "const": "conversation_entity"
          },
          "aliases": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true,
            "default": []
          },
          "status": {
            "type": "string",
            "enum": [
              "active",
              "draft",
              "deprecated",
              "merged"
            ]
          },
          "created_at": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "updated_at": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "content_file": {
            "type": "string",
            "pattern": "^conversation_entities/conv_ent_\\d{6}_.+\\.md$"
          },
          "scope": {
            "type": "string"
          },
          "summary": {
            "type": "string"
          },
          "resource_conversations": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "date",
                "title"
              ],
              "properties": {
                "conversation_id": {
                  "type": "string"
                },
                "date": {
                  "type": "string",
                  "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
                },
                "title": {
                  "type": "string",
                  "minLength": 1
                },
                "turn_range": {
                  "type": "string"
                },
                "summary_file": {
                  "type": "string",
                  "pattern": "^conversation_entities/.+\\.md$"
                },
                "note": {
                  "type": "string"
                }
              }
            }
          },
          "related_entities": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "normal_entities": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^ent_\\d{6}$"
                },
                "uniqueItems": true
              },
              "conversation_entities": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^conv_ent_\\d{6}$"
                },
                "uniqueItems": true
              },
              "engineering_entities": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^eng_ent_\\d{6}$"
                },
                "uniqueItems": true
              }
            }
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          },
          "notes": {
            "type": "string"
          }
        }
      }
    }
  }
}

